/* ── Global ─────────────────────────────────────────────── */

Screen {
    background: $surface;
}

/* ── Run List Screen ───────────────────────────────────── */

RunListScreen {
    layout: vertical;
}

RunListScreen #title-bar {
    height: 3;
    width: 100%;
    content-align: center middle;
    padding: 0 2;
    border: solid $primary-lighten-3;
    color: $text;
    text-style: bold;
}

RunListScreen #run-table {
    height: 1fr;
    width: 100%;
}

RunListScreen #empty-message {
    content-align: center middle;
    height: 1fr;
    color: $text-muted;
}

/* ── Run Detail Screen ─────────────────────────────────── */

RunDetailScreen {
    layout: vertical;
}

RunDetailScreen #run-header {
    height: 3;
    padding: 0 2;
    background: $surface;
    border-bottom: solid $primary-lighten-3;
}

RunDetailScreen #stage-bar {
    height: 3;
    padding: 0 2;
    background: $surface-darken-1;
    border-bottom: solid $primary-lighten-3;
}

RunDetailScreen #main-content {
    height: 1fr;
}

RunDetailScreen #event-log {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    scrollbar-size: 1 1;
}

/* ── Artifact Browser ─────────────────────────────────── */

RunDetailScreen #artifact-browser {
    width: 1fr;
    height: 100%;
    border-left: solid $primary-lighten-3;
}

RunDetailScreen #artifact-browser.-hidden {
    display: none;
}

RunDetailScreen #artifact-list {
    height: 25%;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

RunDetailScreen #artifact-preview {
    height: 1fr;
    padding: 0 1;
    border-top: solid $primary-lighten-3;
    overflow: auto auto;
    scrollbar-size: 1 1;
}

RunDetailScreen #artifact-empty {
    height: auto;
    padding: 1 2;
    color: $text-muted;
    text-style: italic;
}

/* Wide layout: preview beside file list */
Screen.-wide RunDetailScreen #artifact-browser {
    width: 1fr;
    layout: horizontal;
}

Screen.-wide RunDetailScreen #artifact-list {
    width: 35;
    height: 100%;
    overflow-y: auto;
}

Screen.-wide RunDetailScreen #artifact-preview {
    width: 1fr;
    height: 100%;
    overflow: auto auto;
    border-top: none;
    border-left: solid $primary-lighten-3;
}

RunDetailScreen #run-gone {
    content-align: center middle;
    height: 1fr;
    color: $text-muted;
}
